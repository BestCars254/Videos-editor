{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(uv:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(yt-dlp:*)",
      "Bash(npx:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
